{
  "name": "phobos-launcher",
  "version": "1.2.5",
  "description": "PHOBOS Core Launcher — Start, stop, and update your local AI engine",
  "author": {
    "name": "Autarch Industries",
    "email": "dev@autarch.net"
  },
  "main": "main.js",
  "scripts": {
    "dev": "electron . --dev",
    "build": "node scripts/sync-version.mjs && electron-builder --publish never",
    "build:win": "node scripts/sync-version.mjs && electron-builder --win --publish never",
    "build:mac": "node scripts/sync-version.mjs && electron-builder --mac --publish never",
    "build:linux": "node scripts/sync-version.mjs && electron-builder --linux --publish never",
    "build:all": "node build.all.mjs"
  },
  "build": {
    "appId": "net.autarch.phobos-launcher",
    "productName": "PHOBOS Launcher",
    "copyright": "Copyright © 2026 Autarch Industries",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "config.js",
      "index.html",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "Utility"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.utilities"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  }
}